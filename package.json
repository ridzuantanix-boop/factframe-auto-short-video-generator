{
  "name": "auto-short-video-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "studio": "node scripts/start-factory.mjs",
    "worker": "node --env-file=.env.local --import tsx scripts/factory-worker.ts",
    "test:factory": "node --import tsx --test tests/factory.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:cloud": "vite build --config cloud/vite.config.ts",
    "check:cloud": "tsc -p cloud/tsconfig.json",
    "deploy:cloud": "npm run build:cloud && wrangler deploy",
    "secrets:cloud": "node scripts/cloud-secrets.mjs",
    "test:cloud": "node --import tsx --test tests/cloud.test.ts",
    "test:cloud-integration": "node scripts/cloud-integration.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@google/genai": "^2.21.0",
    "image-size": "^2.0.2",
    "lucide-react": "^0.542.0",
    "next": "16.3.4",
    "onnxruntime-web": "^1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "wrangler": "^4.114.0"
  }
}
